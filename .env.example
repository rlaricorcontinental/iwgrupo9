# SQL Server SA password (min 8 chars, uppercase, lowercase, digit, symbol)
SA_PASSWORD=Ismael_Cargo#2026

# Dominio publico (para Let's Encrypt y nginx server_name)
DOMAIN=rlaricor.com

# Puerto host HTTPS del frontend (nginx 443 dentro del contenedor)
HTTPS_PORT=8080

# Puerto host de SQL Server (deja 1433 o cambia si choca)
DB_PORT=1433

# Secreto JWT (cambialo a uno largo y aleatorio en produccion)
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio

# Email para registro de Let's Encrypt (avisos de expiracion)
